{
  "ssot_version": "0.4",
  "taxonomy": {
    "version": "taxonomy-v0.1",
    "categories": [
      "Anti-Israel",
      "Anti-Judaism",
      "Classical Antisemitism",
      "Structural Antisemitism",
      "Conspiracy Theories",
      "Not Antisemitic"
    ],
    "fallback_category": "Not Antisemitic"
  },
  "policy": {
    "prompt_version": "prompt-v0.3-independent-checks",
    "model_version": "ollama:qwen2.5:7b",
    "expected_columns": [
      "Item number",
      "Post text",
      "Category"
    ],
    "supported_languages": [
      "*"
    ],
    "review_modes": [
      "full",
      "partial",
      "none"
    ],
    "low_confidence_threshold": 0.65,
    "soft_signal_review_threshold": 0.35,
    "soft_signal_flags": [
      "SOFT_SIGNAL_COLLECTIVE_BLAME",
      "SOFT_SIGNAL_DUAL_LOYALTY",
      "SOFT_SIGNAL_CODED_CONSPIRACY",
      "SOFT_SIGNAL_DOGWHISTLE",
      "SOFT_SIGNAL_HOLOCAUST_MINIMIZATION"
    ]
  },
  "runtime": {
    "classifier": {
      "backend": "ollama",
      "model": "qwen2.5:7b",
      "fallback_backend": "ollama",
      "fallback_model": "gemma2:9b"
    },
    "drafter": {
      "backend": "ollama",
      "model": "granite4:350m",
      "fallback_backend": "ollama",
      "fallback_model": "gemma3:1b,llama3.2:1b"
    },
    "judge": {
      "backend": "ollama",
      "model": "llama3.1:8b",
      "fallback_backend": "ollama",
      "fallback_model": "gemma2:2b"
    },
    "evaluation": {
      "single_model": "mlx://mlx-community/Apertus-8B-Instruct-2509-4bit",
      "ensemble_models": [
        "ollama://qwen2.5:7b",
        "ollama://gemma2:9b",
        "ollama://llama3.1:8b"
      ]
    },
    "security": {
      "ollama_url": "http://127.0.0.1:11434/api/generate",
      "allow_remote_ollama": false
    }
  },
  "automatic_reporting": {
    "enabled": true,
    "minimum_positive_confidence": 0.3,
    "trigger": "any_current_positive_analysis_including_retries",
    "human_review_required": false,
    "report_status": "AI-generated, unconfirmed",
    "human_decisions_take_precedence": true
  }
}
